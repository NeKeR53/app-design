{
  "name": "socle-ui",
  "version": "1.28.0",
  "description": "Socle — design system React partagé par les apps web et desktop (Tauri).",
  "private": true,
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "eslint-config",
    "ai",
    "biome"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./theme.css": "./dist/theme.css",
    "./eslint-config": "./eslint-config/index.js",
    "./package.json": "./package.json",
    "./biome": "./biome/biome.json",
    "./markdown": {
      "types": "./dist/entries/markdown.d.ts",
      "import": "./dist/markdown.js"
    },
    "./markdown-editor": {
      "types": "./dist/entries/markdown-editor.d.ts",
      "import": "./dist/markdown-editor.js"
    }
  },
  "bin": {
    "socle-check-css": "./eslint-config/check-css.js"
  },
  "scripts": {
    "dev": "storybook dev -p 6006 --no-open",
    "build": "npm run typecheck && vite build && tsc -p tsconfig.build.json && npm run build:css && npm run build:ai && npm run build:biome",
    "build:ai": "node scripts/build-ai-docs.js",
    "build:biome": "node scripts/build-biome.js",
    "publish:local": "npm run build && npx yalc push --private --update",
    "build:css": "tailwindcss -i src/styles.css -o dist/styles.css --minify && node scripts/build-theme.js",
    "build-storybook": "storybook build -o storybook-static",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "check": "node scripts/check.js && node scripts/check-biome.js && npm run lint && npm run typecheck && npm run test"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "@xterm/addon-fit": "^0.10.0 || ^0.11.0",
    "@xterm/xterm": "^5.5.0 || ^6.0.0",
    "pdfjs-dist": ">=5.0.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@lezer/highlight": "^1.2.5"
  },
  "peerDependenciesMeta": {
    "@xterm/addon-fit": {
      "optional": true
    },
    "@xterm/xterm": {
      "optional": true
    },
    "pdfjs-dist": {
      "optional": true
    },
    "react-markdown": {
      "optional": true
    },
    "remark-gfm": {
      "optional": true
    },
    "@codemirror/commands": {
      "optional": true
    },
    "@codemirror/lang-markdown": {
      "optional": true
    },
    "@codemirror/language": {
      "optional": true
    },
    "@codemirror/state": {
      "optional": true
    },
    "@codemirror/view": {
      "optional": true
    },
    "@lezer/highlight": {
      "optional": true
    }
  },
  "dependencies": {
    "@internationalized/date": "^3.12.4",
    "react-aria-components": "^1.22.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "@storybook/addon-docs": "^10.6.8",
    "@storybook/addon-vitest": "^10.6.8",
    "@storybook/react-vite": "^10.6.8",
    "@tailwindcss/cli": "^4.3.5",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/browser-playwright": "^5.1.1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "eslint": "^10.15.0",
    "pdfjs-dist": "^6.5.438",
    "playwright": "^1.65.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "storybook": "^10.6.8",
    "tailwindcss": "^4.3.5",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.1",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@lezer/highlight": "^1.2.5",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  }
}
